    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000115</IRI>
        <Literal>definition</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
