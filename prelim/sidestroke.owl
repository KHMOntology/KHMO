    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/sig/ont/fma/definition"/>
        <IRI>#KHMO_00000001</IRI>
        <Literal>A composite of various integrated human anatomical parts contributing to human movement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_00000001</IRI>
        <Literal xml:lang="en">human kinetic coordinated movement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/sig/ont/fma/definition"/>
        <IRI>#KHMO_00000002</IRI>
        <Literal>A posture expressed specifically by a human being</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_00000002</IRI>
        <Literal xml:lang="en">human stance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/sig/ont/fma/definition"/>
        <IRI>#KHMO_00000003</IRI>
        <Literal>A physical posture defining a starting point of a human-based movement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_00000003</IRI>
        <Literal xml:lang="en">initial human stance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/sig/ont/fma/definition"/>
        <IRI>#KHMO_00000004</IRI>
        <Literal>A human posture that expresses the end goal of a human-based movement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_00000004</IRI>
        <Literal xml:lang="en">realized human stance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000119"/>
        <IRI>#KHMO_00000005</IRI>
        <Literal>https://en.wikipedia.org/wiki/Physical_activity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/sig/ont/fma/definition"/>
        <IRI>#KHMO_00000005</IRI>
        <Literal>&quot;defined as any voluntary bodily movement produced by skeletal muscles that requires energy expenditure. Physical activity encompasses all activities, at any intensity, performed during any time of day or night. It includes both voluntary exercise and incidental activity integrated into the daily routine&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_00000005</IRI>
        <Literal xml:lang="en">planned physical activity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://schema.org/image"/>
        <IRI>#KHMO_0009342</IRI>
        <Literal>https://raw.githubusercontent.com/ProfTuan/KHMO/main/images/KHMO_0009342.png</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#KHMO_0009342</IRI>
        <Literal xml:lang="en">Pull phase. Push off from wall. Position body on side.  Body will remain in a well-aligned, streamlined position. Top arm (trailing arm) rests at side. Float on side, legs are straight, bottom arm (leading arm) extended forward underwater and sweeps backward with semicircular movement. Palm pushes water backward, first sweeping dowanwards and backward then upwards and inwards.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_0009342</IRI>
        <Literal xml:lang="en">Pull and Push beginning</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://schema.org/image"/>
        <IRI>#KHMO_0009343</IRI>
        <Literal>https://raw.githubusercontent.com/ProfTuan/KHMO/main/images/KHMO_0009343.png</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#KHMO_0009343</IRI>
        <Literal xml:lang="en">Push phase. Hand is in front of chest, palm rotwated upwards. Trailing arm moves forward, bending mostly at elbow. Hand slides forward along body until both hands meet in front of chest. Palms facing each other with trailing arm rotated downwards. Top leg moves forward relative to body. Hip and knee bend simultaneously until both joints bent slightly less than 45 degrees. Top foot follows along. Bottom leg moves in opposite direction and bends slightly backward at hip and more than 90 degrees at knee. Effectively push water backward with shin and top of foot.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_0009343</IRI>
        <Literal xml:lang="en">Pull and Push ending</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://schema.org/image"/>
        <IRI>#KHMO_0009345</IRI>
        <Literal>https://raw.githubusercontent.com/ProfTuan/KHMO/main/images/KHMO_0009345.png</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#KHMO_0009345</IRI>
        <Literal xml:lang="en">Push phase. Hand is in front of chest, palm rotwated upwards. Trailing arm moves forward, bending mostly at elbow. Hand slides forward along body until both hands meet in front of chest. Palms facing each other with trailing arm rotated downwards. Top leg moves forward relative to body. Hip and knee bend simultaneously until both joints bent slightly less than 45 degrees. Top foot follows along. Bottom leg moves in opposite direction and bends slightly backward at hip and more than 90 degrees at knee. Effectively push water backward with shin and top of foot.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#KHMO_0009345</IRI>
        <Literal xml:lang="en">Push and Glide beginning</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://schema.org/image"/>
        <IRI>#KHMO_0009346</IRI>
        <Literal>https://raw.githubusercontent.com/ProfTuan/KHMO/main/images/KHMO_0009346.png</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#KHMO_0009346</IRI>
        <Literal xml:lang="en">Glide phase. Arms extend and return to initial positions. Palm rotates from upwards to downward facing position. Trailing hand executes semicircular backward sweep. Palm moves first backwards and downwards, then backward and upwards, until arm is fully extended and resting at side. A short glide is observed before a new stroke cycle begins.</Literal>
    </AnnotationAssertion>
