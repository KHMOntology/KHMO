    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.obolibrary.org/obo/IAO_0000115</IRI>
        <IRI>http://purl.obolibrary.org/obo/iao.owl</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
