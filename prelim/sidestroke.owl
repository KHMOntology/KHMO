        <IRI>http://purl.obolibrary.org/obo/BFO_0000017</IRI>
        <Literal xml:lang="en">the disposition of your blood to coagulate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>http://purl.obolibrary.org/obo/BFO_0000017</IRI>
        <Literal xml:lang="en">the function of your reproductive organs</Literal>
