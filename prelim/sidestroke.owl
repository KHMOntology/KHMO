        <IRI>http://purl.obolibrary.org/obo/BFO_0000019</IRI>
        <Literal xml:lang="en">the mass of this piece of gold.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>http://purl.obolibrary.org/obo/BFO_0000019</IRI>
        <Literal xml:lang="en">the shape of your nose</Literal>
    </AnnotationAssertion>
