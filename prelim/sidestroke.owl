        <IRI>http://purl.obolibrary.org/obo/BFO_0000050</IRI>
        <IRI>http://ontologydesignpatterns.org/wiki/Community:Parts_and_Collections</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
