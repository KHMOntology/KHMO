    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/RO_0002131</IRI>
        <Literal>x overlaps y if and only if there exists some z such that x has part z and z part of y</Literal>
